<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main">


    <TextView
        android:id="@+id/textView2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Student name"
        android:textSize="30dp"
        android:layout_centerHorizontal="true"
        />
<HorizontalScrollView
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <Button
            android:id="@+id/mathpp2"
            android:layout_width="100dp"
            android:layout_height="80dp"
            android:layout_marginLeft="10dp"
            android:gravity="bottom"
            android:textColor="#55574e"
            android:layout_marginTop="65dp"
            android:background="@drawable/math"
            app:backgroundTint="@null"
            />
        <Button
            android:id="@+id/englishpp2"
            android:layout_width="100dp"
            android:layout_height="80dp"
            android:text="english"
            android:gravity="bottom"
            android:textColor="#55574e"
            android:layout_marginTop="65dp"
            android:layout_toRightOf="@id/mathpp2"
            android:layout_marginLeft="20dp"
            android:background="@drawable/rectangle_btn"
            />

        <Button
            android:id="@+id/sciencepp2"
            android:layout_width="100dp"
            android:layout_height="80dp"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="65dp"
            android:layout_toRightOf="@id/englishpp2"
            android:gravity="bottom"
            android:text="science"
            android:background="@drawable/rectangle_btn"
            />

        <Button
            android:id="@+id/pepp2"
            android:layout_width="100dp"
            android:layout_height="80dp"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="65dp"
            android:gravity="bottom"
            android:layout_toRightOf="@id/sciencepp2"
            android:background="@drawable/rectangle_btn"
            android:text="pe" />
        <androidx.cardview.widget.CardView
            android:id="@+id/agriculturePP2"
            android:layout_width="100dp"
            android:layout_height="80dp"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="65dp"
            android:gravity="bottom"
            android:layout_toRightOf="@id/pepp2"
            app:cardCornerRadius="9dp"
            ><LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/math"></LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</HorizontalScrollView>
    <FrameLayout
        android:id="@+id/FL"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="150dp">
        <ImageButton
            android:id="@+id/imgb"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/math"
            android:visibility="gone"/>
    </FrameLayout>





</RelativeLayout>