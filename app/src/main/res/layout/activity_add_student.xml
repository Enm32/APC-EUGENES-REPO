<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".addStudent">
    <TextView
        android:id="@+id/tv_addstudent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ADD STUDENT"
        android:textSize="24sp"
        android:textColor="@android:color/black"
        android:layout_margin="30dp"
        />
    <EditText
        android:id="@+id/addstudent_name"
        android:layout_width="300dp"
        android:layout_height="50dp"
        android:hint=" Student Name"
        android:background="@drawable/edit_text_background"
        android:inputType="textPersonName"
        android:layout_marginStart="30dp"
        android:layout_below="@id/tv_addstudent"
        />
    <Spinner
        android:id="@+id/addStudentSpinner"
        android:layout_width="300dp"
        android:layout_height="50dp"
        android:background="@drawable/edit_text_background"
        android:layout_marginStart="30dp"
        android:layout_marginTop="32dp"
        android:entries="@array/Grades"
        android:layout_below="@id/addstudent_name"
    />


    <Button
        android:id="@+id/btn_addStudent"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:text="Sign Up"
        android:backgroundTint="@android:color/holo_blue_light"
        android:textColor="@android:color/white"
        android:layout_marginTop="32dp"
        android:layout_below="@id/addStudentSpinner"
        android:layout_marginStart="30dp"
       />
<ProgressBar
    android:id="@+id/klpb"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_centerInParent="true"
    android:visibility="gone"/>
</RelativeLayout>