<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/login_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".otLogin"
    >
    <TextView
        android:id="@+id/ttvlogin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/enter_email_to_receive_otp_code"
        android:layout_marginTop="45dp"
        android:layout_marginStart="60dp"
        android:fontFamily="sans-serif-condensed"
        android:textSize="40sp"
        android:textStyle="bold"/>
    <LinearLayout
        android:id="@+id/kldhdj"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/ttvlogin"
        android:layout_marginStart="45dp"
        android:layout_marginTop="40dp"
        android:background="@drawable/edit_text_background">

        <EditText
            android:id="@+id/ec_edittext"
            android:layout_width="205dp"
            android:layout_height="60dp"
            android:background="@drawable/edit_text_background"
            android:hint="@string/prompt_email"
            android:importantForAutofill="no"
            android:inputType="text"
            android:paddingStart="5dp"
            android:textColorHint="#757575"
            tools:ignore="RtlSymmetry" />
    </LinearLayout>
    <Button
        android:id="@+id/otpsend"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/kldhdj"
        android:layout_marginTop="50dp"
        android:text="@string/send_otp"/>
    <Button
        android:id="@+id/verifyotp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toEndOf="@id/otpsend"
        android:layout_below="@id/kldhdj"
        android:layout_marginTop="50dp"
        android:layout_marginStart="70dp"
        android:text="@string/verify"/>



</RelativeLayout>