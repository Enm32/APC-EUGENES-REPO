<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".pp1_material.pp1_rate">
    <TextView
        android:id="@+id/textviewpp1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Student name"
        android:textSize="30dp"
        android:layout_centerHorizontal="true"
        android:textColor="@color/black"
        />


    <HorizontalScrollView
        android:id="@+id/Horizontal_viewpp1"
        android:layout_marginTop="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/mathpp1"
                android:layout_width="130dp"
                android:layout_height="70dp"
                android:layout_marginLeft="10dp"
                android:layout_marginTop="60dp"
                android:background="@drawable/rectangle_btn"
                android:gravity="bottom"
                android:text="Maths"
                app:backgroundTint="@null" />

            <Button
                android:id="@+id/lapp1"
                android:layout_width="130dp"
                android:layout_height="70dp"
                android:text="Language Activities"
                android:gravity="bottom"
                android:layout_marginTop="45dp"
                android:layout_toRightOf="@id/mathpp2"
                android:layout_marginLeft="20dp"
                android:background="@drawable/rectangle_btn"
                app:backgroundTint="@null"
                />

            <Button
                android:id="@+id/capp1"
                android:layout_width="130dp"
                android:layout_height="70dp"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="45dp"
                android:layout_toRightOf="@id/lapp1"
                android:gravity="bottom"
                android:text="Creative activities"
                android:background="@drawable/rectangle_btn"
                app:backgroundTint="@null"
                />

            <Button
                android:id="@+id/eapp1"
                android:layout_width="130dp"
                android:layout_height="70dp"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="45dp"
                android:gravity="bottom"
                android:layout_toRightOf="@id/capp1"
                android:background="@drawable/rectangle_btn"
                android:text="Environmental Activities"
                app:backgroundTint="@null"/>
            <androidx.cardview.widget.CardView
                android:id="@+id/rapp1"
                android:layout_width="130dp"
                android:layout_height="70dp"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="61dp"
                android:gravity="bottom"
                android:layout_toRightOf="@id/eapp1"
                app:cardCornerRadius="9dp"
                ><LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/rectangle_btn">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Religious Activitie"
                    android:layout_gravity="bottom"
                    android:layout_marginLeft="5dp"
                    android:layout_marginBottom="5dp"
                    android:textColor="@color/white"/>
            </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </HorizontalScrollView>
    <TextView
        android:id="@+id/topicheaderpp1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Topics"
        android:textSize="40px"
        android:textStyle="bold"
        android:layout_marginStart="10dp"
        android:layout_marginTop="20dp"
        android:layout_below="@id/Horizontal_viewpp1"
        />
    <FrameLayout
        android:id="@+id/FLpp1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_below="@id/topicheaderpp1"
        />

</RelativeLayout>