<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".Strands.Agriculture_jss">
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Conserving our environment"
        android:layout_marginTop="40dp"
        android:textStyle="bold"
        />
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:layout_marginStart="185dp"
        android:background="@drawable/spinner_background"
        >

        <Spinner
            android:id="@+id/conservation"
            android:layout_width="75dp"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:entries="@array/ratingValues"
            tools:ignore="TouchTargetSizeCheck" />
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="5dp"
            android:src="@drawable/star"/>
    </LinearLayout>


    <LinearLayout
        android:layout_width="300dp"
        android:layout_height="1px"
        android:layout_marginTop="68dp"
        android:background="@color/black"
        android:orientation="horizontal" />




    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Domestic animals"
        android:layout_marginTop="80dp"
        android:textStyle="bold"
        />
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="80dp"
        android:layout_marginStart="185dp"
        android:background="@drawable/spinner_background"
        >

        <Spinner
            android:id="@+id/Domestic_animals"
            android:layout_width="75dp"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:entries="@array/ratingValues"
            tools:ignore="TouchTargetSizeCheck" />
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="5dp"
            android:src="@drawable/star"/>
    </LinearLayout>



    <LinearLayout
        android:layout_width="300dp"
        android:layout_height="1px"
        android:layout_marginTop="109dp"
        android:background="@color/black"
        android:orientation="horizontal" />



    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Gardening"
        android:layout_marginTop="121dp"
        android:textStyle="bold"
        />
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="121dp"
        android:layout_marginStart="185dp"
        android:background="@drawable/spinner_background"
        >

        <Spinner
            android:id="@+id/gardening"
            android:layout_width="75dp"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:entries="@array/ratingValues"
            tools:ignore="TouchTargetSizeCheck" />
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="5dp"
            android:src="@drawable/star"/>
    </LinearLayout>







    <ProgressBar
        android:id="@+id/idLoadingPB_agri"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />


</FrameLayout>