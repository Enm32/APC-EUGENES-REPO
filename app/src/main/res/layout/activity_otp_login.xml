<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".otpLoginActivity">

    <TextView
        android:id="@+id/tv_confirmation_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Enter confirmation code"
        android:textSize="24sp"
        android:textColor="@android:color/black"
        android:layout_marginTop="32dp"
        android:layout_centerHorizontal="true"/>

    <TextView
        android:id="@+id/tv_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="A 6-digit code was sent to enm@email.com"
        android:textSize="16sp"
        android:textColor="@android:color/darker_gray"
        android:layout_below="@id/tv_confirmation_title"
        android:layout_marginTop="8dp"
        android:layout_centerHorizontal="true"/>

    <LinearLayout
        android:id="@+id/ll_code_inputs"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_below="@id/tv_subtitle"
        android:layout_marginTop="24dp"
        android:layout_centerHorizontal="true">

        <EditText
            android:id="@+id/et_code_1"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginEnd="8dp"
            android:background="@android:color/white"
            android:backgroundTint="@android:color/darker_gray"
            android:gravity="center"
            android:inputType="number"
            android:textSize="18sp"
            tools:ignore="SpeakableTextPresentCheck" />

        <EditText
            android:id="@+id/et_code_2"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:background="@android:color/white"
            android:gravity="center"
            android:inputType="number"
            android:textSize="18sp"
            android:layout_marginEnd="8dp"
            android:backgroundTint="@android:color/darker_gray"/>

        <EditText
            android:id="@+id/et_code_3"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/background2"
            android:backgroundTint="@android:color/darker_gray"
            android:gravity="center"
            android:inputType="number"
            android:textSize="18sp"
            tools:ignore="SpeakableTextPresentCheck" />

        <EditText
            android:id="@+id/et_code_4"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:background="@android:color/white"
            android:gravity="center"
            android:inputType="number"
            android:textSize="18sp"
            android:layout_marginEnd="8dp"
            android:backgroundTint="@android:color/darker_gray"/>

        <EditText
            android:id="@+id/et_code_5"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginEnd="8dp"
            android:background="@android:color/white"
            android:backgroundTint="@android:color/darker_gray"
            android:gravity="center"
            android:inputType="number"
            android:textSize="18sp"
            tools:ignore="SpeakableTextPresentCheck" />
        <EditText
            android:id="@+id/et_code_6"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:background="@android:color/white"
            android:gravity="center"
            android:inputType="number"
            android:textSize="18sp"
            android:layout_marginEnd="8dp"
            android:backgroundTint="@android:color/darker_gray"/>
    </LinearLayout>

    <TextView
        android:id="@+id/tv_resend_code"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Resend code"
        android:textSize="14sp"
        android:textColor="@android:color/holo_blue_dark"
        android:layout_below="@id/ll_code_inputs"
        android:layout_marginTop="16dp"
        android:layout_centerHorizontal="true"/>

    <Button
        android:id="@+id/btn_continue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Continue"
        android:backgroundTint="@android:color/holo_blue_light"
        android:textColor="@android:color/white"
        android:layout_below="@id/tv_resend_code"
        android:layout_marginTop="24dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"/>
</RelativeLayout>