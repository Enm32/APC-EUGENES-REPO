<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".otpLoginActivity">

    <TextView
        android:id="@+id/tv_confirmation_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Enter confirmation code"
        android:textSize="24sp"
        android:textColor="@android:color/black"
        android:layout_marginTop="32dp"
        android:layout_centerHorizontal="true"/>

    <TextView
        android:id="@+id/tv_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="A 6-digit code was sent to your email"
        android:textSize="16sp"
        android:textColor="@android:color/darker_gray"
        android:layout_below="@id/tv_confirmation_title"
        android:layout_marginTop="8dp"
        android:layout_centerHorizontal="true"/>



        <EditText
            android:id="@+id/code"
            android:layout_width="150dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_below="@id/tv_subtitle"
            android:layout_centerHorizontal="true"
            android:gravity="center"
            android:inputType="number"
            android:textSize="18sp"
            tools:ignore="SpeakableTextPresentCheck" />



    <TextView
        android:id="@+id/tv_resend_code"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Resend code"
        android:textSize="14sp"
        android:textColor="@android:color/holo_blue_dark"
        android:layout_below="@id/code"
        android:layout_marginTop="16dp"
        android:layout_centerHorizontal="true"/>

    <Button
        android:id="@+id/btn_continue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Continue"
        android:backgroundTint="@android:color/holo_blue_light"
        android:textColor="@android:color/white"
        android:layout_below="@id/tv_resend_code"
        android:layout_marginTop="24dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"/>
    <ProgressBar
        android:id="@+id/pb_cv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:visibility="gone"/>
</RelativeLayout>