<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".pp2_material.englishpp2frag">

<LinearLayout
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="40dp">
    <TextView
        android:id="@+id/eng_verbs"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="verbs"
        android:textStyle="bold"
        />
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/spinner_background"
        android:layout_marginStart="164dp">
        <Spinner
            android:id="@+id/verbsSpinner"
            android:layout_width="75dp"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:entries="@array/ratingValues"/>
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="5dp"
            android:src="@drawable/star"/>
    </LinearLayout>
</LinearLayout>

       <LinearLayout
        android:id="@+id/l1"
        android:layout_width="300dp"
        android:layout_height="1px"
        android:layout_marginTop="68dp"
        android:background="@color/black"
        android:orientation="horizontal"/>




<LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="80dp">
        <TextView
            android:id="@+id/eng_nouns"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="nouns"
            android:textStyle="bold"
            />
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/spinner_background"
            android:layout_marginStart="159dp"
            >
            <Spinner
                android:id="@+id/nounsSpinner"
                android:layout_width="75dp"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:entries="@array/ratingValues"/>
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="5dp"
                android:src="@drawable/star"/>
        </LinearLayout>
    </LinearLayout>

<LinearLayout
        android:id="@+id/l2"
        android:layout_width="300dp"
        android:layout_height="1px"
        android:layout_marginTop="107dp"
        android:background="@color/black"
        android:orientation="horizontal" />




<LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="120dp">
    <TextView
        android:id="@+id/eng_adv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="adverbs"
        android:textStyle="bold"
        />
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/spinner_background"
            android:layout_marginStart="149dp"
            >
            <Spinner
                android:id="@+id/adverbsSpinner"
                android:layout_width="75dp"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:entries="@array/ratingValues"/>
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="5dp"
                android:src="@drawable/star"/>
        </LinearLayout>
    </LinearLayout>




</FrameLayout>