<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".pp2_material.mathpp2">
  <TextView
      android:id="@+id/topcheader"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:text="Topics"
      android:textStyle="bold"
      android:layout_marginTop="10dp"
      />
  <TextView
      android:id="@+id/math_multi"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
     android:text="multiplication"
      android:layout_marginTop="40dp"
      />
    <TextView
        android:id="@+id/math_sub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="subtraction"
        android:layout_marginTop="70dp"
        />

  <LinearLayout
      android:layout_width="300dp"
      android:layout_height="1px"
      android:layout_marginTop="61dp"
      android:background="@color/black" />

  <TextView
        android:id="@+id/math_add"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="addition"
        android:layout_marginTop="105dp"
        />
  <LinearLayout
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="105dp"
      android:layout_marginStart="95dp"
      android:background="@drawable/spinner_background"
      >
    <Spinner
        android:id="@+id/additionSpinner"
        android:layout_width="75dp"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:entries="@array/ratingValues"/>
    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="5dp"
        android:src="@drawable/star"/>
  </LinearLayout>

  <Spinner
      android:id="@+id/subtractionSpinner"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="70dp"
      android:layout_toRightOf="@id/math_sub"
      android:layout_marginStart="95dp"
      android:entries="@array/ratingValues"
      />

  <ProgressBar
      android:id="@+id/idLoadingPB"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_gravity="center"

      android:visibility="gone" />

</FrameLayout>