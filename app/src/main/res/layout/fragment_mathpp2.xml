<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".pp2_material.mathpp2">

  <TextView
      android:id="@+id/math_multi"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
     android:text="multiplication"
      />
    <TextView
        android:id="@+id/math_sub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="subtraction"
        android:layout_marginTop="30dp"
        />
    <TextView
        android:id="@+id/math_add"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="addition"
        android:layout_marginTop="65dp"
        />
  <Spinner
      android:id="@+id/additionSpinner"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="65dp"
    android:layout_marginStart="95dp"
      android:entries="@array/ratingValues"/>
  <Spinner
      android:id="@+id/subtractionSpinner"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="30dp"
      android:layout_toRightOf="@id/math_sub"
      android:layout_marginStart="95dp"
      android:entries="@array/ratingValues"/>
  <ProgressBar
      android:id="@+id/idLoadingPB"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_gravity="center_vertical"
      android:visibility="gone" />

</FrameLayout>